{
  "name": "monaco-helix",
  "version": "0.1.0",
  "description": "Selection-first Helix keybindings for the Monaco editor",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "author": "Seohyun Lee <me@seorii.page>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seo-rii/monaco-helix.git"
  },
  "homepage": "https://github.com/seo-rii/monaco-helix#readme",
  "bugs": {
    "url": "https://github.com/seo-rii/monaco-helix/issues"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "helix",
    "keybindings",
    "modal",
    "editor"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/styles.css",
    "./keymap": {
      "types": "./dist/keymap.d.ts",
      "import": "./dist/keymap.js"
    },
    "./toml": {
      "types": "./dist/toml.d.ts",
      "import": "./dist/toml.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./macros": {
      "types": "./dist/macros.d.ts",
      "import": "./dist/macros.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js"
    },
    "./tree-sitter": {
      "types": "./dist/tree-sitter.d.ts",
      "import": "./dist/tree-sitter.js"
    },
    "./syntax-worker": "./dist/syntax-worker.js",
    "./syntax-assets/*": "./dist/syntax-assets/*"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-style.mjs && node scripts/copy-syntax-assets.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "check": "npm run typecheck && npm test && npm run test:package && npm run test:browser",
    "test:package": "npm run build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "monaco-editor": "0.55.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "tree-sitter-wasms": "0.1.13"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "optionalDependencies": {
    "web-tree-sitter": "0.25.10"
  }
}
